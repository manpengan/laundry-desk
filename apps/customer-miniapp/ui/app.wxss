page {
  background: #f4f7f6;
  color: #173830;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 30rpx;
}
.page {
  padding: 32rpx 28rpx 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}
.hero {
  padding: 20rpx 8rpx 32rpx;
}
.eyebrow {
  color: #47685e;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin: 12rpx 0;
}
.muted {
  color: #536a63;
  font-size: 26rpx;
  line-height: 1.6;
}
.card {
  background: #fff;
  border: 1rpx solid #d8e2dd;
  border-radius: 22rpx;
  padding: 28rpx;
  margin: 20rpx 0;
}
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0;
}
.row text {
  overflow-wrap: anywhere;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
button {
  font-size: 28rpx;
  min-height: 88rpx;
  line-height: 1.4;
  padding: 24rpx;
  border-radius: 14rpx;
  color: #173830;
  background: #edf3f0;
  margin: 0;
}
button::after {
  border: 0;
}
button.primary {
  color: #fff;
  background: #176348;
}
button[disabled] {
  color: #77837e;
  background: #e8edeb;
}
.full {
  width: 100%;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.tabs button {
  flex: 1;
  padding: 22rpx 12rpx;
}
.tabs .active {
  background: #173f32;
  color: white;
}
.error,
.notice {
  padding: 24rpx;
  border-radius: 14rpx;
  margin: 18rpx 0;
  line-height: 1.6;
}
.error {
  background: #ffebe7;
  color: #922e1e;
}
.notice {
  background: #e2f2e9;
  color: #18543c;
}
.amount {
  font-size: 54rpx;
  font-weight: 700;
  margin: 20rpx 0;
}
.badge {
  font-size: 24rpx;
  color: #176348;
  background: #edf5ef;
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
}
.label {
  display: block;
  color: #425c52;
  font-size: 26rpx;
  margin: 24rpx 0 12rpx;
}
input,
picker,
textarea {
  width: auto;
  min-height: 68rpx;
  border: 1rpx solid #b6c8bf;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  font-size: 30rpx;
  line-height: 1.6;
}
textarea {
  height: 150rpx;
}
.divider {
  border-top: 1rpx solid #e3ebe7;
  padding-top: 20rpx;
  margin-top: 20rpx;
}
.empty {
  text-align: center;
  padding: 48rpx 20rpx;
  color: #536a63;
  line-height: 1.8;
}
