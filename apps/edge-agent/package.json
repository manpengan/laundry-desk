{
  "name": "@laundry/edge-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run spa:sync && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src scripts --ext .ts,.tsx,.mjs --max-warnings=0",
    "test": "node --test scripts/*.test.mjs && tsc -p tsconfig.json && node --test $(find dist -name '*.test.js')",
    "typecheck": "node --check scripts/sync-spa.mjs && node --check scripts/sync-spa.test.mjs && tsc -p tsconfig.json --noEmit",
    "spa:sync": "node scripts/sync-spa.mjs sync",
    "spa:check": "node scripts/sync-spa.mjs check",
    "printer-smoke": "tsc -p tsconfig.json && node dist/print/printer-smoke-cli.js"
  },
  "dependencies": {
    "@laundry/contracts": "file:../../packages/contracts",
    "iconv-lite": "0.6.3"
  },
  "devDependencies": {
    "electron": "41.10.2",
    "proper-lockfile": "4.1.2"
  }
}
