FROM node:22-bookworm-slim AS build

WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/platform-fs/package.json packages/platform-fs/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts \
  --filter @laundry/server... \
  --filter @laundry/platform-fs... \
  --filter @laundry/web...

COPY apps/server apps/server
COPY apps/web apps/web
COPY packages/config/tsconfig packages/config/tsconfig
COPY packages/contracts packages/contracts
COPY packages/domain packages/domain
COPY packages/platform-fs packages/platform-fs
COPY packages/ui packages/ui
COPY tools/local/lan-gateway-config.mjs tools/local/lan-gateway-config.mjs
COPY tools/local/lan-gateway-core.mjs tools/local/lan-gateway-core.mjs
COPY tools/local/lan-gateway-lifecycle.mjs tools/local/lan-gateway-lifecycle.mjs
COPY tools/local/lan-runtime-entrypoint.mjs tools/local/lan-runtime-entrypoint.mjs
COPY tools/local/lan-runtime-healthcheck.mjs tools/local/lan-runtime-healthcheck.mjs

RUN pnpm --filter @laundry/platform-fs build \
  && pnpm --filter @laundry/server... build \
  && pnpm --filter @laundry/ui build \
  && pnpm --filter @laundry/web build \
  && pnpm --filter @laundry/server deploy --legacy --prod /runtime/server \
  && rm -rf /runtime/server/src \
  && rm -rf /runtime/server/node_modules/@laundry/contracts/src \
  && rm -rf /runtime/server/node_modules/@laundry/domain/src

FROM node:22-bookworm-slim AS runtime

RUN groupadd --gid 10001 laundry \
  && useradd --uid 10001 --gid 10001 --no-create-home \
    --home-dir /nonexistent --shell /usr/sbin/nologin laundry \
  && install -d --owner=10001 --group=10001 --mode=0700 /var/lib/laundry/photos \
  && printf 'laundry-desk-photo-store:v1\n' \
    > /var/lib/laundry/photos/.laundry-photo-store-v1 \
  && chown 10001:10001 /var/lib/laundry/photos/.laundry-photo-store-v1 \
  && chmod 0600 /var/lib/laundry/photos/.laundry-photo-store-v1

ARG RUNTIME_RELEASE
ARG RUNTIME_CONTRACTS_MAJOR
ARG RUNTIME_CONTRACTS_SHA256
ARG RUNTIME_SERVER_VERSION
ARG RUNTIME_WEB_BUNDLE_SHA256
ARG RUNTIME_SCHEMA_SHA256
ARG RUNTIME_MIGRATIONS_SHA256
ARG RUNTIME_MIGRATION_HEAD

RUN test -n "${RUNTIME_RELEASE}" \
  && test -n "${RUNTIME_CONTRACTS_MAJOR}" \
  && test -n "${RUNTIME_CONTRACTS_SHA256}" \
  && test -n "${RUNTIME_SERVER_VERSION}" \
  && test -n "${RUNTIME_WEB_BUNDLE_SHA256}" \
  && test -n "${RUNTIME_SCHEMA_SHA256}" \
  && test -n "${RUNTIME_MIGRATIONS_SHA256}" \
  && test -n "${RUNTIME_MIGRATION_HEAD}"

LABEL org.opencontainers.image.title="Laundry Desk Runtime Server" \
  org.opencontainers.image.version="${RUNTIME_SERVER_VERSION}" \
  com.laundry-desk.runtime.release="${RUNTIME_RELEASE}" \
  com.laundry-desk.runtime.contracts-major="${RUNTIME_CONTRACTS_MAJOR}" \
  com.laundry-desk.runtime.contracts-sha256="${RUNTIME_CONTRACTS_SHA256}" \
  com.laundry-desk.runtime.server-version="${RUNTIME_SERVER_VERSION}" \
  com.laundry-desk.runtime.web-bundle-sha256="${RUNTIME_WEB_BUNDLE_SHA256}" \
  com.laundry-desk.runtime.schema-sha256="${RUNTIME_SCHEMA_SHA256}" \
  com.laundry-desk.runtime.migrations-sha256="${RUNTIME_MIGRATIONS_SHA256}" \
  com.laundry-desk.runtime.migration-head="${RUNTIME_MIGRATION_HEAD}"

WORKDIR /opt/laundry/server
COPY --chown=10001:10001 --from=build /runtime/server /opt/laundry/server
COPY --chown=10001:10001 --from=build /workspace/apps/web/dist-spa /opt/laundry/owner-spa
COPY --chown=10001:10001 --from=build /workspace/tools/local/lan-gateway-config.mjs /workspace/tools/local/lan-gateway-core.mjs /workspace/tools/local/lan-gateway-lifecycle.mjs /opt/laundry/lan-gateway/
COPY --chown=10001:10001 --from=build /workspace/tools/local/lan-runtime-entrypoint.mjs /opt/laundry/lan-gateway/lan-runtime-entrypoint.mjs
COPY --chown=10001:10001 --from=build /workspace/tools/local/lan-runtime-healthcheck.mjs /opt/laundry/lan-gateway/lan-runtime-healthcheck.mjs
COPY --chown=10001:10001 packages/db/src/migrations /opt/laundry/migrations

ENV NODE_ENV=production
EXPOSE 8787

USER 10001:10001

ENTRYPOINT ["node", "/opt/laundry/server/dist/runtime/kit-entrypoint.js"]
CMD ["server"]
