{
  "name": "@laundry/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.host.json && vite build --config vite.config.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "pnpm run build && node --test $(find dist -name '*.test.js')",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json && tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@laundry/domain": "file:../../packages/domain",
    "@laundry/ui": "file:../../packages/ui",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3"
  }
}
