{
  "name": "@laundry/platform-fs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "native/windows/laundry-windows-helper.exe",
    "native/windows/laundry-windows-helper.exe.sha256"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run native:build && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint . --ext .ts,.mjs --max-warnings=0",
    "native:build": "node scripts/build-windows-helper.mjs",
    "test": "pnpm run native:build && tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "typecheck": "node --check scripts/build-windows-helper.mjs && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
