{
  "name": "laundry-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11 <12"
  },
  "description": "laundry-desk v2 产品化升级 monorepo（含冻结的 v1 迁移资产）",
  "main": "./out/main/index.js",
  "author": "manpengan",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "rebuild:app-deps": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "vitest",
    "test:e2e": "playwright test",
    "rebuild:node": "npm rebuild better-sqlite3",
    "build:web": "electron-vite build && node scripts/fix-web-html.mjs",
    "serve": "npm run build:web && npm run rebuild:node && node out/main/server.js",
    "serve:only": "npm run rebuild:node && node out/main/server.js",
    "serve:lan": "LAUNDRY_HOST=0.0.0.0 npm run serve:only",
    "workspace:build": "turbo run build",
    "workspace:audit": "node tools/local/dependency-audit.mjs",
    "workspace:dev": "turbo run dev",
    "workspace:format:check": "prettier --check apps packages tools/cloud tools/local tools/compose tools/migrate-v1 tools/release-candidate/*.mjs tools/runtime-kit/*.mjs tools/runtime-kit/README.md tests/foundation docs/local-web-server.md docs/operations/dependency-audit.md .github/workflows/foundation.yml .github/workflows/v2-integration.yml .prettierrc.cjs package.json pnpm-workspace.yaml turbo.json",
    "workspace:lint": "eslint tools/cloud --ext .mjs --max-warnings=0 && eslint tools/local tools/release-candidate tests/foundation tools/runtime-kit/*.mjs --ext .mjs --max-warnings=0 && turbo run lint",
    "workspace:test": "node --test tools/local/*.test.mjs tools/runtime-kit/*.test.mjs tests/foundation/*.test.mjs && turbo run test",
    "workspace:typecheck": "turbo run typecheck",
    "workspace:check": "pnpm run workspace:audit && pnpm run workspace:format:check && pnpm run workspace:lint && pnpm run workspace:typecheck && pnpm run workspace:test && pnpm run cloud:adr36:acceptance:test && pnpm run workspace:build",
    "local:bootstrap": "pnpm --filter @laundry/contracts build && pnpm --filter @laundry/domain build && pnpm --filter @laundry/server build && node apps/server/dist/local/bootstrap-cli.js",
    "local:server": "pnpm --filter @laundry/contracts build && pnpm --filter @laundry/domain build && pnpm --filter @laundry/server build && node apps/server/dist/http/main.js",
    "ai:provider:deepseek:smoke": "pnpm --filter @laundry/contracts build && pnpm --filter @laundry/server build && node tools/local/ai-provider-deepseek-smoke.mjs",
    "local:web": "pnpm --filter @laundry/ui build && pnpm --filter @laundry/web exec vite --config vite.config.ts",
    "local:web:commissioning:e2e": "pnpm exec playwright test -c apps/web/playwright.commissioning.config.ts",
    "local:web:e2e": "pnpm exec playwright test -c apps/web/playwright.local.config.ts",
    "local:lan": "pnpm --filter @laundry/ui build && pnpm --filter @laundry/web build && node tools/local/lan-gateway.mjs",
    "local:lan:onboard": "node tools/local/lan-onboard.mjs",
    "local:lan:diagnose": "node tools/local/lan-diagnose.mjs",
    "local:lan:e2e": "pnpm exec playwright test -c apps/web/playwright.lan.config.ts",
    "local:mac:build": "pnpm --filter @laundry/edge-agent package:mac",
    "local:mac:e2e": "pnpm exec playwright test -c apps/edge-agent/playwright.electron.config.ts",
    "local:mac:commissioning:e2e": "pnpm exec playwright test -c apps/edge-agent/playwright.electron.commissioning.config.ts",
    "local:commissioning:fresh:browser": "node tools/local/commissioning-acceptance.mjs browser",
    "local:commissioning:fresh:mac": "node tools/local/commissioning-acceptance.mjs mac",
    "local:commissioning:fresh:pg": "node tools/local/commissioning-acceptance.mjs pg",
    "local:commissioning:fresh:e2e": "pnpm local:mac:build && node tools/local/commissioning-acceptance.mjs",
    "runtime:app:build": "node tools/runtime-kit/build-app.mjs",
    "runtime:app:inspect": "node tools/runtime-kit/inspect-app.mjs",
    "runtime:app:acceptance": "node tools/runtime-kit/runtime-app-acceptance.mjs",
    "runtime:counter:acceptance": "node tools/runtime-kit/runtime-counter-loopback-acceptance.mjs",
    "runtime:lan:no-repo:acceptance": "node tools/runtime-kit/build-app.mjs --testing && node tools/runtime-kit/inspect-app.mjs 'tools/runtime-kit/dist/Laundry Desk Runtime Test.app' && node tools/runtime-kit/no-repo-lan-acceptance.mjs",
    "runtime:lan:container:acceptance": "node tools/runtime-kit/real-container-lan-acceptance.mjs",
    "runtime:lan:acceptance": "pnpm runtime:lan:no-repo:acceptance && pnpm runtime:lan:container:acceptance",
    "runtime:data:no-repo:acceptance": "node tools/runtime-kit/runtime-data-acceptance.mjs",
    "runtime:data:container:acceptance": "node tools/runtime-kit/real-container-transfer-acceptance.mjs",
    "runtime:data:acceptance": "pnpm runtime:data:no-repo:acceptance && pnpm runtime:data:container:acceptance",
    "runtime:app:lint:swift": "xcrun swift-format lint --strict --recursive tools/runtime-kit/Sources",
    "release:candidate:assemble": "node tools/release-candidate/assemble.mjs",
    "release:candidate:verifier": "node tools/release-candidate/build-verifier.mjs",
    "release:candidate:test": "node --test tools/local/release-candidate.test.mjs",
    "release:candidate:swift:check": "xcrun swift-format lint --strict --recursive tools/release-candidate/Sources && xcrun swiftc -typecheck -target arm64-apple-macos13.0 tools/release-candidate/Sources/*.swift -framework CryptoKit -framework Foundation && xcrun swiftc -typecheck -target x86_64-apple-macos13.0 tools/release-candidate/Sources/*.swift -framework CryptoKit -framework Foundation",
    "runtime:manifest:generate": "node tools/runtime-kit/generate-manifest.mjs",
    "runtime:release:mac": "node tools/runtime-kit/release-app.mjs",
    "local:acceptance": "node tools/local/acceptance.mjs",
    "local:backup": "node tools/local/backup.mjs",
    "local:maintenance": "node tools/local/maintenance.mjs",
    "local:maintenance:schedule": "node tools/local/maintenance-launchd.mjs",
    "local:restore:drill": "node tools/local/restore-drill.mjs",
    "local:restore": "node tools/local/restore.mjs",
    "local:diagnose": "node tools/local/diagnose.mjs",
    "local:support-bundle": "node tools/local/support-bundle.mjs",
    "local:up": "node tools/local/up.mjs",
    "local:down": "node tools/local/down.mjs",
    "local:reset": "node tools/local/reset.mjs",
    "cloud:adr36:acceptance": "node tools/cloud/adr36-web-acceptance.mjs",
    "cloud:adr36:acceptance:test": "node --test tools/cloud/*.test.mjs",
    "cloud:web:e2e": "pnpm exec playwright test -c apps/web/playwright.cloud.config.ts",
    "cloud:release:hk": "node tools/cloud/hk-vps-release.mjs",
    "cloud:data:hk": "node tools/cloud/hk-vps-data-protection.mjs"
  },
  "build": {
    "appId": "com.laundry-desk",
    "productName": "laundry-desk V2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "laundry-desk V2"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "manpengan",
        "repo": "laundry-desk"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-slot": "^1.2.4",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "electron-pos-printer": "^1.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.3.0",
    "tencentcloud-sdk-nodejs-sms": "^4.0.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@anthropic-ai/sdk": "^0.112.3",
    "@google/genai": "^2.12.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "electron": "41.10.3",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.34.0",
    "openai": "^6.48.0",
    "postcss": "8.5.23",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "turbo": "2.10.5",
    "typescript": "^5.5.0",
    "vite": "7.3.6",
    "vitest": "^3.2.6"
  }
}
