{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@laundry/customer-miniapp#build": {
      "dependsOn": ["^build", "@laundry/contracts#build"],
      "outputs": ["dist/**"]
    },
    "@laundry/customer-miniapp#typecheck": {
      "dependsOn": ["^build", "@laundry/contracts#build"],
      "outputs": []
    },
    "@laundry/customer-miniapp#test": {
      "dependsOn": ["^build", "@laundry/contracts#build"],
      "outputs": []
    },
    "@laundry/web#test": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/ui#build",
        "@laundry/domain#build"
      ],
      "outputs": []
    },
    "@laundry/web#typecheck": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/ui#build",
        "@laundry/domain#build"
      ]
    },
    "@laundry/web#build": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/ui#build",
        "@laundry/domain#build"
      ],
      "outputs": ["dist/**", "dist-spa/**"],
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@laundry/db#test": {
      "dependsOn": ["^build", "@laundry/contracts#build"]
    },
    "@laundry/db#typecheck": {
      "dependsOn": ["^build", "@laundry/contracts#build"]
    },
    "@laundry/db#build": {
      "dependsOn": ["^build", "@laundry/contracts#build"],
      "outputs": ["dist/**"]
    },
    "@laundry/edge-agent#typecheck": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/platform-fs#build",
        "@laundry/server#build"
      ]
    },
    "@laundry/edge-agent#test": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/platform-fs#build",
        "@laundry/web#test"
      ]
    },
    "@laundry/edge-agent#build": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/platform-fs#build",
        "@laundry/web#build"
      ],
      "outputs": ["dist/**", "!dist/profile-*/**", "!dist/windows-profile/**", "resources/spa/**"]
    },
    "@laundry/server#typecheck": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/domain#build",
        "@laundry/platform-fs#build",
        "@laundry/migrate-v1#build"
      ]
    },
    "@laundry/server#test": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/domain#build",
        "@laundry/platform-fs#build",
        "@laundry/migrate-v1#build"
      ]
    },
    "@laundry/server#build": {
      "dependsOn": [
        "^build",
        "@laundry/contracts#build",
        "@laundry/domain#build",
        "@laundry/platform-fs#build",
        "@laundry/migrate-v1#build"
      ],
      "outputs": ["dist/**"]
    },
    "@laundry/migrate-v1#build": {
      "dependsOn": ["^build", "@laundry/platform-fs#build"],
      "outputs": ["dist/**"]
    },
    "@laundry/migrate-v1#typecheck": {
      "dependsOn": ["^build", "@laundry/platform-fs#build"],
      "outputs": []
    },
    "@laundry/migrate-v1#test": {
      "dependsOn": ["^build", "@laundry/platform-fs#build"],
      "outputs": []
    }
  }
}
